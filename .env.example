# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chatbot (Gemini) - server-only
GEMINI_API_KEY=

# Supabase server-side access for chat history (RLS is on, tables have no browser policies).
# SUPABASE_SECRET_KEY (sb_secret_...) bypasses RLS: never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public (publishable) key for public-read tables such as schools. Safe to expose, unlike the secret key.
SUPABASE_PUBLISHABLE_KEY=

# Make.com webhook that receives every new quote request (contains a secret token: never commit)
MAKE_WEBHOOK_URL=

# Make.com webhook called when an admin approves a quote request (customer name, email, login link).
# Contains a secret token: never commit.
MAKE_APPROVAL_WEBHOOK_URL=
# Login link emailed to approved customers: this site's /login page (Sign in with Google).
# Production: the real domain, e.g. https://your-domain/login (not localhost).
STUDENT_LOGIN_URL=
